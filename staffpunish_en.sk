on inventory-click:
	name of event-inventory is "{@unpunishgui}"
	cancel event 

	clicked inventory is player's inventory:
		stop

	index of event-slot is 11:
		{lastunpunish.%player%} is banned:
			set {_v} to {lastunpunish.%player%}
			unban {lastunpunish.%player%} 
			delete {ban::%{_v}%::*}
			set {ban::%{_v}%::state} to "<#32EA27>Not banned"
			close player's inventory 
			send "{@p} &7You have <#EF7726>%{_v}% <#32EA28>unbanned"
			loop all players:
				loop-player has permission "punishok.unpunish.notify":
					send "{@p} <#32EA28>%{_v}% &7was unbanned by <#EF7726>%player%"

	index of event-slot is 15:
		set {_v} to {lastunpunish.%player%}
		{mute::%{_v}%::status} is true:
			set {mutestate.%{_v}%} to "<#32EA27>Not muted"
			set {mute::%{_v}%::status} to false 
			delete {mute::%{_v}%::*}
			close player's inventory 
			send "{@p} &7You have <#EF7726>%{_v}% <#32EA28>unmuted"
			loop all players:
				loop-player has permission "punishok.unpunish.notify":
					send "{@p} <#32EA28>%{_v}% &7was unmuted by <#EF7726>%player%" to loop-player
			{_v} is online:
				send "%nl%{@p} &7You were <#32EA28>unmuted" to {_v}
				send "{@p} &7Moderator: &3%player%%nl%" to {_v}

on inventory-click:
	name of event-inventory is "{@kickgui}"
	cancel event 

	clicked inventory is player's inventory:
		stop

	index of event-slot is 0:
		punishmenu(player, {lastpunish.%player%})

	index of event-slot is 10:
		set {_v} to {lastpunish.%player%}
		{_v} is online:
			kick {_v} due to "%nl%%nl%{@p} &7You were &4&lKICKED%nl%%nl%&7Reason: &3Disrupting a shop purchase%nl%&7Moderator: &3%player%"
			send "{@p} &7You have <#3BFA30>%{_v}% <#FAB330>kicked"
			loop all players:
				loop-player has permission "punishok.notify":
					send "%nl%{@p} <#EF7726>%player%&7 has <#3BFA30>%{_v}% kicked%nl%{@p} &7Reason: <#FAB330>Disrupting a shop purchase%nl%"
			close player's inventory 
			send title "&3&lPLAYER KICKED" to player for 2 seconds

	index of event-slot is 11:
		set {_v} to {lastpunish.%player%}
		{_v} is online:
			kick {_v} due to "%nl%%nl%{@p} &7You were &4&lKICKED%nl%%nl%&7Reason: &3Please &3&nrejoin%nl%&7Moderator: &3%player%"
			send "{@p} &7You have <#3BFA30>%{_v}% <#FAB330>kicked"
			loop all players:
				loop-player has permission "punishok.notify":
					send "%nl%{@p} <#EF7726>%player%&7 has <#3BFA30>%{_v}% kicked%nl%{@p} &7Reason: <#FAB330>Please rejoin%nl%"
			close player's inventory
			send title "&3&lPLAYER KICKED" to player for 2 seconds

on inventory-click:
	name of event-inventory is "{@mutegui}"
	cancel event 
	
	clicked inventory is player's inventory:
		stop 

	index of event-slot is 0:
		punishmenu(player, {lastpunish.%player%})

	index of event-slot is 10:
		set {_v} to {lastpunish.%player%}
		{mute::%{_v}%::status} is true:
			stop 
		set {mute::%{_v}%::status} to true
		set {mute::%{_v}%::state} to "<#14A7A7>Muted"
		set {mute::%{_v}%::reason} to "<#14A7A7>Advertising"
		set {mute::%{_v}%::mod} to "<#14A7A7>%player%"
		set {mute::%{_v}%::duration} to "<#14A7A7>Permanent"
		set {mute::%{_v}%::date} to now
		set {mutestate.%{_v}%} to "<#DB1515>Muted"
		wait 1 tick
		set {mute::%{_v}%::enddate} to "<#14A7A7>Never"
		set {mute::%{_v}%::msg} to "%nl%{@p} &7You were &4&lMUTED%nl%{@p} &7Reason: %{mute::%{_v}%::reason}%%nl%{@p} &7Duration: %{mute::%{_v}%::duration}%%nl%{@p} &7Ends: %{mute::%{_v}%::enddate}%%nl%"
		{_v} is online:
			send {mute::%{_v}%::msg} to {_v}
		close player's inventory
		loop all players:
			loop-player has permission "punishok.notify":
				send "%nl%{@p} <#3BFA30>%player% &7has <#EF7726>%{_v}% &7muted%nl%{@p} &7Reason: <#EF7726>Advertising%nl%{@p} &7Duration: <#EF7726>Permanent%nl%" to loop-player
		send title "&3&lPLAYER MUTED" to player for 2 seconds 
		send subtitle "&8„&fMinecraft, but you are not allowed to play.&8“" to player for 2 seconds

	index of event-slot is 11:
		set {_v} to {lastpunish.%player%}
		{mute::%{_v}%::status} is true:
			stop 
		set {mute::%{_v}%::status} to true
		set {mute::%{_v}%::state} to "<#14A7A7>Muted"
		set {mute::%{_v}%::reason} to "<#14A7A7>Chas restriction"
		set {mute::%{_v}%::mod} to "<#14A7A7>%player%"
		set {mute::%{_v}%::duration} to "<#14A7A7>Permanent"
		set {mute::%{_v}%::date} to now
		set {mutestate.%{_v}%} to "<#DB1515>Muted"
		wait 1 tick
		set {mute::%{_v}%::enddate} to "<#14A7A7>Never"
		set {mute::%{_v}%::msg} to "%nl%{@p} &7You were &4&lMUTED%nl%{@p} &7Reason: %{mute::%{_v}%::reason}%%nl%{@p} &7Duration: %{mute::%{_v}%::duration}%%nl%{@p} &7Ends: %{mute::%{_v}%::enddate}%%nl%"
		{_v} is online:
			send {mute::%{_v}%::msg} to {_v}
		close player's inventory
		loop all players:
			loop-player has permission "punishok.notify":
				send "%nl%{@p} <#3BFA30>%player% &7has <#EF7726>%{_v}% &7muted%nl%{@p} &7Reason: <#EF7726>Chas restriction%nl%{@p} &7Duration: <#EF7726>Permanent%nl%" to loop-player
		send title "&3&lPLAYER MUTED" to player for 2 seconds 
		send subtitle "&8„&fYour Wi-Fi now has more rights than you.&8“" to player for 2 seconds

	index of event-slot is 12:
		set {_v} to {lastpunish.%player%}
		{mute::%{_v}%::status} is true:
			stop 
		set {mute::%{_v}%::status} to true
		set {mute::%{_v}%::state} to "<#14A7A7>Muted"
		set {mute::%{_v}%::reason} to "<#14A7A7>Child protection"
		set {mute::%{_v}%::mod} to "<#14A7A7>%player%"
