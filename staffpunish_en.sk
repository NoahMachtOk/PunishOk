		loop all players:
			loop-player has permission "punishok.notify":
				send "%nl%{@p} <#3BFA30>%player% &7has <#EF7726>%{_v}% &7muted%nl%{@p} &7Reason: <#EF7726>Severe insult%nl%{@p} &7Duration: <#EF7726>10 hours%nl%" to loop-player
		send title "&3&lPLAYER MUTED" to player for 2 seconds 
		send subtitle "&8„&fThe chas is not a boxing ring&8“" to player for 2 seconds
	
	index of event-slot is 23:
		set {_v} to {lastpunish.%player%}
		{mute::%{_v}%::status} is true:
			stop 
		set {mute::%{_v}%::status} to true
		set {mute::%{_v}%::state} to "<#14A7A7>Muted"
		set {mute::%{_v}%::reason} to "<#14A7A7>Insult"
