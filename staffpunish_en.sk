function banmenu(m: player, v: offline player):
	set {_banmenu} to a new chest inventory with 4 row named "{@bangui}"
	set slot 0 of {_banmenu} to arrow named "&8» &7Back to Homepage"
	set slot 1 of {_banmenu} to black stained glass pane named "&f"
