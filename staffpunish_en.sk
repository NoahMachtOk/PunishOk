function timeleft(t: player) :: boolean:
	set {_time} to {mute::%{_t}%::date} + {mute::%{_t}%::dur}
	{_time} > now:
		set {_left} to difference between now and {_time} 
		set {mute::%{_t}%::left} to {_left}
		return true 
	else:
		return false 

function calcleft(t: offline player) :: timespan:
	set {_time} to {mute::%{_t}%::date} + {mute::%{_t}%::dur}
	if {_time} > now:
		return difference between now and {_time}


command /punish <offline player>:
	permission: dreamcraft.system.punish 
	permission message: {@p} &7You do not have permission for this!
	usage: {@p} &7Syntax: &e/punish <player>
	trigger:
		{mutestate.%arg-1%} is not set:
			set {mutestate.%arg-1%} to "<#32EA27>Not muted"
		{ban::%arg-1%::state} is not set:
			set {ban::%arg-1%::state} to "<#32EA27>Not banned"
		arg-1 has permission "dreamcraft.system.punish.bypass":
			send "{@p} &7You cannot punish this player!"
			stop 
		punishmenu(player, arg-1)

command /unpunish <offline player>:
	permission: punishok.unpunish 
	permission message: {@p} &7You do not have permission for this!
	usage: {@p} &7Syntax: &e/unpunish <player>
	trigger:
		unpunishmenu(player, arg-1)

on inventory-click:
	name of event-inventory is "{@gui}"
	cancel event 

	clicked inventory is player's inventory:
		stop

	index of event-slot is 11:
		banmenu(player, {lastpunish.%player%})

	index of event-slot is 15:
		mutemenu(player, {lastpunish.%player%})
	
	index of event-slot is 21:
		kickmenu(player, {lastpunish.%player%})

	index of event-slot is 23:
		make player execute command "/unpunish %{lastpunish.%player%}%"

on inventory-click:
	name of event-inventory is "{@bangui}"
	cancel event 

	clicked inventory is player's inventory:
		stop 

	index of event-slot is 0:
		punishmenu(player, {lastpunish.%player%})

	index of event-slot is 10:
		set {_v} to {lastpunish.%player%}
		{ban::%{_v}%::status} is true:
			stop 
		set {ban::%{_v}%::status} to true
		set {ban::%{_v}%::state} to "<#DB1515>Banned"
		set {ban::%{_v}%::reason} to "<#EF7726>Permanent ban"
		set {ban::%{_v}%::mod} to "<#EF7726>%player%"
		set {ban::%{_v}%::duration} to "<#EF7726>Permanent"
		ban and kick {_v} due to "%nl%%nl%{@p} &7You were &4&lBANNED%nl%%nl%&7Reason: &3Permanent ban%nl%&7Moderator: &3%player%%nl%&7Duration: &3Permanent%nl%&7Ends in: &3Never%nl%%nl%&7Unban request: &e{@dc}"
		send "{@p} &7You have <#EF7726>%{_v}% &7banned"
		loop all players:
			loop-player has permission "punishok.notify":
				send "%nl%{@p} <#3BFA30>%player% &7has <#EF7726>%{_v}% &7banned%nl%{@p} &7Reason: <#EF7726>Permanent ban%nl%{@p} &7Duration: <#EF7726>Permanent%nl%"
		close player's inventory 
		send title "&3&lPLAYER BANNED" to player for 2 seconds 
		send subtitle "&8„&fAs stated in the server constitution: out.&8“"
	
	index of event-slot is 11:
		set {_v} to {lastpunish.%player%}
