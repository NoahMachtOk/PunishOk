on command:
	command is "msg" or "message" or "whisper" or "w" or "tell" or "t" or "me":
		{mute::%player%::status} is true:
			timeleft(player) is true:
				set {_v} to player 
				cancel event 
				set {_left} to calcleft({_v})
				set {_days} to days of {_left}
				set {_hours} to hours of {_left}
				set {_minutes} to minutes of {_left}
				set {_text} to "%{_days}% days, %{_hours}% hours and %{_minutes}% minutes"
				set {_totalDays} to days of {_left}
				set {_totalHours} to hours of {_left}
				set {_totalminutes} to minutes of {_left}
				set {_hours} to {_totalHours} - ({_totalDays} * 24)
				set {_minutes} to {_totalminutes} - ({_totalDays} * 1440) - ({_hours} * 60)
				set {mute::%{_v}%::left} to "<#14A7A7>%{_totalDays}% days, %{_hours}% hours and %{_minutes}% minutes"
				# set {mute::%{_v}%::left} to "<#14A7A7>%{_left}%"
				set {mute::%{_v}%::msg} to "%nl%{@p} &7You are &4&lMUTED%nl%{@p} &7Reason: %{mute::%{_v}%::reason}%%nl%{@p} &7Duration: %{mute::%{_v}%::duration}%%nl%{@p} &7Ends: %{mute::%{_v}%::enddate}%%nl%{@p} &7Remaining: %{mute::%{_v}%::left}%%nl%"
				send {mute::%player%::msg} to player 
			else:
				set {_v} to player 
				set {mutestate.%{_v}%} to "<#32EA27>Not muted"
				set {mute::%{_v}%::status} to false 
				delete {mute::%{_v}%::*}
				loop all players:
					loop-player has permission "punishok.unpunish.notify":
						send "{@p} <#32EA28>%{_v}% &7was <#EF7726>automatically <#32EA28>unmuted" to loop-player
				send "%nl%{@p} &7You were automatically <#32EA28>unmuted%nl%{@p} &7Your punishment is over, please follow%nl%{@p} &7the rules in the future. Have fun!%nl%" to {_v}

on chas:
	{mute::%player%::status} is true:
		timeleft(player) is true:
			set {_v} to player 
			cancel event 
			set {_left} to calcleft({_v})
			set {_days} to days of {_left}				
			set {_hours} to hours of {_left}
			set {_minutes} to minutes of {_left}
			set {_text} to "%{_days}% days, %{_hours}% hours and %{_minutes}% minutes"
			set {_totalDays} to days of {_left}
			set {_totalHours} to hours of {_left}
			set {_totalminutes} to minutes of {_left}
			set {_hours} to {_totalHours} - ({_totalDays} * 24)
			set {_minutes} to {_totalminutes} - ({_totalDays} * 1440) - ({_hours} * 60)
			set {mute::%{_v}%::left} to "<#14A7A7>%{_totalDays}% days, %{_hours}% hours and %{_minutes}% minutes"
			# set {mute::%{_v}%::left} to "<#14A7A7>%{_left}%"
			set {mute::%{_v}%::msg} to "%nl%{@p} &7You are &4&lMUTED%nl%{@p} &7Reason: %{mute::%{_v}%::reason}%%nl%{@p} &7Duration: %{mute::%{_v}%::duration}%%nl%{@p} &7Ends: %{mute::%{_v}%::enddate}%%nl%{@p} &7Remaining: %{mute::%{_v}%::left}%%nl%"
			send {mute::%player%::msg} to player 
		else:
			set {_v} to player 
			set {mutestate.%{_v}%} to "<#32EA27>Not muted"
			set {mute::%{_v}%::status} to false 
			delete {mute::%{_v}%::*}
			loop all players:
				loop-player has permission "punishok.unpunish.notify":
					send "{@p} <#32EA28>%{_v}% &7was <#EF7726>automatically <#32EA28>unmuted" to loop-player
			send "%nl%{@p} &7You were automatically <#32EA28>unmuted%nl%{@p} &7Your punishment is over, please follow%nl%{@p} &7the rules in the future. Have fun!%nl%" to {_v} 

on join:
	{ban::%player%::status} is true:
		wait 2 seconds
		player is online:
			set {_v} to player 
			delete {ban::%{_v}%::*}
			set {ban::%{_v}%::state} to "<#32EA27>Not banned"
			close player's inventory 
			loop all players:
				loop-player has permission "punishok.unpunish.notify":
					send "{@p} <#32EA28>%{_v}% &7was <#EF7726>automatically <#32EA28>unbanned"