on inventory-click:
	name of event-inventory is "{@unpunishgui}"
	cancel event 

	clicked inventory is player's inventory:
		stop

	index of event-slot is 11:
		{lastunpunish.%player%} is banned:
			set {_v} to {lastunpunish.%player%}
			unban {lastunpunish.%player%} 
			delete {ban::%{_v}%::*}
			set {ban::%{_v}%::state} to "<#32EA27>Nicht gebannt"
			close player's inventory 
			send "{@p} &7Du hast <#EF7726>%{_v}% <#32EA28>entbannt"
			loop all players:
				loop-player has permission "dreamcraft.system.unpunish.notify":
					send "{@p} <#32EA28>%{_v}% &7wurde von <#EF7726>%player% <#32EA28>entbannt"

	index of event-slot is 15:
		set {_v} to {lastunpunish.%player%}
		{mute::%{_v}%::status} is true:
			set {mutestate.%{_v}%} to "<#32EA27>Nicht gemutet"
			set {mute::%{_v}%::status} to false 
			delete {mute::%{_v}%::*}
			close player's inventory 
			send "{@p} &7Du hast <#EF7726>%{_v}% <#32EA28>entmuted"
			loop all players:
				loop-player has permission "dreamcraft.system.unpunish.notify":
					send "{@p} <#32EA28>%{_v}% &7wurde von <#EF7726>%player% <#32EA28>entmuted" to loop-player
			{_v} is online:
				send "%nl%{@p} &7Du wurdest <#32EA28>entmuted" to {_v}
				send "{@p} &7Moderator: &3%player%%nl%" to {_v}

on inventory-click:
	name of event-inventory is "{@kickgui}"
	cancel event 

	clicked inventory is player's inventory:
		stop

	index of event-slot is 0:
		punishmenu(player, {lastpunish.%player%})

	index of event-slot is 10:
		set {_v} to {lastpunish.%player%}
		{_v} is online:
			kick {_v} due to "%nl%%nl%{@p} &7Du wurdest &4&lGEKICKT%nl%%nl%&7Grund: &3Stören von Shop-Kauf%nl%&7Moderator: &3%player%"
			send "{@p} &7Du hast <#3BFA30>%{_v}% <#FAB330>gekickt"
			loop all players:
				loop-player has permission "dreamcraft.system.perks.notify":
					send "%nl%{@p} <#EF7726>%player%&7 hat <#3BFA30>%{_v}% gekickt%nl%{@p} &7Grund: <#FAB330>Stören von Shop-Kauf%nl%"
			close player's inventory 
			send title "&3&lSPIELER GEKICKT" to player for 2 seconds

	index of event-slot is 11:
		set {_v} to {lastpunish.%player%}
		{_v} is online:
			kick {_v} due to "%nl%%nl%{@p} &7Du wurdest &4&lGEKICKT%nl%%nl%&7Grund: &3Bitte &3&nrejoinen%nl%&7Moderator: &3%player%"
			send "{@p} &7Du hast <#3BFA30>%{_v}% <#FAB330>gekickt"
			loop all players:
				loop-player has permission "dreamcraft.system.perks.notify":
					send "%nl%{@p} <#EF7726>%player%&7 hat <#3BFA30>%{_v}% gekickt%nl%{@p} &7Grund: <#FAB330>Bitte rejoinen%nl%"
			close player's inventory
			send title "&3&lSPIELER GEKICKT" to player for 2 seconds

on inventory-click:
	name of event-inventory is "{@mutegui}"
	cancel event 
	
	clicked inventory is player's inventory:
		stop 

	index of event-slot is 0:
		punishmenu(player, {lastpunish.%player%})

	index of event-slot is 10:
		set {_v} to {lastpunish.%player%}
		{mute::%{_v}%::status} is true:
			stop 
		set {mute::%{_v}%::status} to true
		set {mute::%{_v}%::state} to "<#14A7A7>Gemuted"
		set {mute::%{_v}%::reason} to "<#14A7A7>Fremdwerbung"
		set {mute::%{_v}%::mod} to "<#14A7A7>%player%"
		set {mute::%{_v}%::duration} to "<#14A7A7>Permanent"
		set {mute::%{_v}%::date} to now
		set {mutestate.%{_v}%} to "<#DB1515>Gemuted"
		wait 1 tick
		set {mute::%{_v}%::enddate} to "<#14A7A7>Nie"
		set {mute::%{_v}%::msg} to "%nl%{@p} &7Du wurdest &4&lGEMUTED%nl%{@p} &7Grund: %{mute::%{_v}%::reason}%%nl%{@p} &7Dauer: %{mute::%{_v}%::duration}%%nl%{@p} &7Endet: %{mute::%{_v}%::enddate}%%nl%"
		{_v} is online:
			send {mute::%{_v}%::msg} to {_v}
		close player's inventory
		loop all players:
			loop-player has permission "dreamcraft.system.punish.notify":
				send "%nl%{@p} <#3BFA30>%player% &7hat <#EF7726>%{_v}% &7gemuted%nl%{@p} &7Grund: <#EF7726>Fremdwerbung%nl%{@p} &7Dauer: <#EF7726>Permanent%nl%" to loop-player
		send title "&3&lSPIELER GEMUTED" to player for 2 seconds 
		send subtitle "&8„&fMinecraft, aber du darfst nicht mitspielen.&8“" to player for 2 seconds

	index of event-slot is 11:
		set {_v} to {lastpunish.%player%}
		{mute::%{_v}%::status} is true:
			stop 
