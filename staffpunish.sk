on command:
	command is "msg" or "message" or "whisper" or "w" or "tell" or "t" or "me":
		{mute::%player%::status} is true:
			timeleft(player) is true:
				set {_v} to player 
				cancel event 
				set {_left} to calcleft({_v})
				set {_days} to days of {_left}
				set {_hours} to hours of {_left}
				set {_minutes} to minutes of {_left}
				set {_text} to "%{_days}% Tage, %{_hours}% Stunden und %{_minutes}% Minuten"
				set {_totalDays} to days of {_left}
				set {_totalHours} to hours of {_left}
				set {_totalMinutes} to minutes of {_left}
				set {_hours} to {_totalHours} - ({_totalDays} * 24)
				set {_minutes} to {_totalMinutes} - ({_totalDays} * 1440) - ({_hours} * 60)
				set {mute::%{_v}%::left} to "<#14A7A7>%{_totalDays}% Tage, %{_hours}% Stunden und %{_minutes}% Minuten"
				# set {mute::%{_v}%::left} to "<#14A7A7>%{_left}%"
				set {mute::%{_v}%::msg} to "%nl%{@p} &7Du bist &4&lGEMUTED%nl%{@p} &7Grund: %{mute::%{_v}%::reason}%%nl%{@p} &7Dauer: %{mute::%{_v}%::duration}%%nl%{@p} &7Endet: %{mute::%{_v}%::enddate}%%nl%{@p} &7Verbleibend: %{mute::%{_v}%::left}%%nl%"
				send {mute::%player%::msg} to player 
			else:
				set {_v} to player 
				set {mutestate.%{_v}%} to "<#32EA27>Nicht gemutet"
				set {mute::%{_v}%::status} to false 
				delete {mute::%{_v}%::*}
				loop all players:
					loop-player has permission "dreamcraft.system.unpunish.notify":
						send "{@p} <#32EA28>%{_v}% &7wurde <#EF7726>automatisch <#32EA28>entmuted" to loop-player
				send "%nl%{@p} &7Du wurdest automatisch <#32EA28>entmuted%nl%{@p} &7Deine Strafe ist vorbei, bitte halte dich%nl%{@p} &7künftig an die Regeln. Viel Spaß!%nl%" to {_v}

on chat:
	{mute::%player%::status} is true:
		timeleft(player) is true:
			set {_v} to player 
			cancel event 
			set {_left} to calcleft({_v})
			set {_days} to days of {_left}				
			set {_hours} to hours of {_left}
			set {_minutes} to minutes of {_left}
			set {_text} to "%{_days}% Tage, %{_hours}% Stunden und %{_minutes}% Minuten"
			set {_totalDays} to days of {_left}
			set {_totalHours} to hours of {_left}
			set {_totalMinutes} to minutes of {_left}
			set {_hours} to {_totalHours} - ({_totalDays} * 24)
			set {_minutes} to {_totalMinutes} - ({_totalDays} * 1440) - ({_hours} * 60)
			set {mute::%{_v}%::left} to "<#14A7A7>%{_totalDays}% Tage, %{_hours}% Stunden und %{_minutes}% Minuten"
			# set {mute::%{_v}%::left} to "<#14A7A7>%{_left}%"
			set {mute::%{_v}%::msg} to "%nl%{@p} &7Du bist &4&lGEMUTED%nl%{@p} &7Grund: %{mute::%{_v}%::reason}%%nl%{@p} &7Dauer: %{mute::%{_v}%::duration}%%nl%{@p} &7Endet: %{mute::%{_v}%::enddate}%%nl%{@p} &7Verbleibend: %{mute::%{_v}%::left}%%nl%"
			send {mute::%player%::msg} to player 
		else:
			set {_v} to player 
			set {mutestate.%{_v}%} to "<#32EA27>Nicht gemutet"
			set {mute::%{_v}%::status} to false 
			delete {mute::%{_v}%::*}
			loop all players:
				loop-player has permission "dreamcraft.system.unpunish.notify":
					send "{@p} <#32EA28>%{_v}% &7wurde <#EF7726>automatisch <#32EA28>entmuted" to loop-player
			send "%nl%{@p} &7Du wurdest automatisch <#32EA28>entmuted%nl%{@p} &7Deine Strafe ist vorbei, bitte halte dich%nl%{@p} &7künftig an die Regeln. Viel Spaß!%nl%" to {_v} 

on join:
	{ban::%player%::status} is true:
		wait 2 seconds
		player is online:
			set {_v} to player 
			delete {ban::%{_v}%::*}
			set {ban::%{_v}%::state} to "<#32EA27>Nicht gebannt"
			close player's inventory 
			loop all players:
				loop-player has permission "dreamcraft.system.unpunish.notify":
					send "{@p} <#32EA28>%{_v}% &7wurde <#EF7726>automatisch <#32EA28>entbannt"