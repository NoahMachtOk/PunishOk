function timeleft(t: player) :: boolean:
	set {_time} to {mute::%{_t}%::date} + {mute::%{_t}%::dur}
	{_time} > now:
		set {_left} to difference between now and {_time} 
		set {mute::%{_t}%::left} to {_left}
		return true 
	else:
		return false 

function calcleft(t: offline player) :: timespan:
	set {_time} to {mute::%{_t}%::date} + {mute::%{_t}%::dur}
	if {_time} > now:
		return difference between now and {_time}


command /punish <offline player>:
	permission: dreamcraft.system.punish 
	permission message: {@p} &7Dazu hast du keine Rechte!
	usage: {@p} &7Syntax: &e/punish <Spieler>
	trigger:
		{mutestate.%arg-1%} is not set:
			set {mutestate.%arg-1%} to "<#32EA27>Nicht gemutet"
		{ban::%arg-1%::state} is not set:
			set {ban::%arg-1%::state} to "<#32EA27>Nicht gebannt"
		arg-1 has permission "dreamcraft.system.punish.bypass":
			send "{@p} &7Diesen Spieler kannst du nicht punishen!"
			stop 
		punishmenu(player, arg-1)

command /unpunish <offline player>:
	permission: dreamcraft.system.unpunish 
	permission message: {@p} &7Dazu hast du keine Rechte!
	usage: {@p} &7Syntax: &e/unpunish <Spieler>
	trigger:
		unpunishmenu(player, arg-1)

on inventory-click:
	name of event-inventory is "{@gui}"
	cancel event 

	clicked inventory is player's inventory:
		stop

	index of event-slot is 11:
		banmenu(player, {lastpunish.%player%})

	index of event-slot is 15:
		mutemenu(player, {lastpunish.%player%})
	
	index of event-slot is 21:
		kickmenu(player, {lastpunish.%player%})

	index of event-slot is 23:
		make player execute command "/unpunish %{lastpunish.%player%}%"

on inventory-click:
	name of event-inventory is "{@bangui}"
	cancel event 

	clicked inventory is player's inventory:
		stop 

	index of event-slot is 0:
		punishmenu(player, {lastpunish.%player%})

	index of event-slot is 10:
		set {_v} to {lastpunish.%player%}
		{ban::%{_v}%::status} is true:
			stop 
		set {ban::%{_v}%::status} to true
		set {ban::%{_v}%::state} to "<#DB1515>Gebannt"
		set {ban::%{_v}%::reason} to "<#EF7726>Hausverbot"
