function punishmenu(m: player, v: offline player):
	set {_punishmenu} to a new chest inventory with 4 row named "{@gui}" 
	set slot 0 of {_punishmenu} to black stained glass pane named "&f"
	set slot 1 of {_punishmenu} to black stained glass pane named "&f"
	set slot 2 of {_punishmenu} to black stained glass pane named "&f"
	set slot 3 of {_punishmenu} to black stained glass pane named "&f"
	set slot 4 of {_punishmenu} to skull of {_v} with name "{@p} &c%{_v}%" with lore "&f" and "&8➥ &7Gebannt: %{ban::%{_v}%::state}%" and "&8➥ &7Muted: %{mutestate.%{_v}%}%" and "&8» &7Aktuelle Seite: &eHomePage &8«"
